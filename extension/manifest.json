{
  "manifest_version": 3,
  "name": "Crumb",
  "short_name": "Crumb",
  "version": "0.1.22",
  "description": "Block cookie nags. Don't give a crumb.",
  "browser_specific_settings": {
    "gecko": {
      "id": "crumb@rcurran.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "48": "icons/48.png",
      "96": "icons/96.png",
      "128": "icons/128.png"
    },
    "default_title": "Crumb",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["data/generic.css"],
      "js": ["data/cosmetic.js", "inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    },
    {
      "matches": ["*://consent.yahoo.com/*", "*://consent.google.com/*"],
      "js": ["data/auto-reject.js", "auto-reject.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cookie_nags",
        "enabled": true,
        "path": "data/dnr-rules.json"
      }
    ]
  }
}
