{
  "name": "crumb",
  "version": "0.1.0",
  "private": true,
  "description": "Block cookie nags in Firefox. Don't give a crumb.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:min": "MINIFY=1 node scripts/build.js",
    "fetch": "node scripts/fetch-external.js",
    "test": "node --test scripts/src/parse.test.js tests/inject.test.js",
    "dev": "web-ext run --source-dir=extension --firefox=firefox",
    "lint": "web-ext lint --source-dir=extension",
    "package": "npm run build:min && web-ext build --source-dir=extension --artifacts-dir=web-ext-artifacts --overwrite-dest",
    "release:upload": "node scripts/amo-upload.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
